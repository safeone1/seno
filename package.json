{
	"name": "seno",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"lint": "turbo run lint",
		"format": "biome check --write .",
		"check-types": "turbo run check-types"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.6",
		"turbo": "^2.10.7",
		"typescript": "5.9.2"
	},
	"engines": {
		"node": ">=18"
	},
	"devEngines": {
		"packageManager": {
			"name": "bun",
			"version": "1.3.6"
		}
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	]
}
